# Optional API-specific overrides. The root .env is loaded automatically.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Set to 1 only when the API is reachable through one trusted reverse proxy.
# TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://task_platform:task_platform_dev@127.0.0.1:5432/task_platform
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=task-platform:
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_SECONDS=604800

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
APP_URL=http://localhost:3000
# MAIL_ENCRYPTION_KEY=<base64-encoded 32 random bytes, separate from the AI key>

MODERATION_ENABLED=true
AI_TIMEOUT_MS=120000
AI_COOLDOWN_SECONDS=60
# AI_KEY_ENCRYPTION_KEY=<base64-encoded 32 random bytes>
# AI_BASE_URL=https://api.example.com/v1/
# AI_MODEL=your-model-name
# AI_API_KEY=

# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Production requires an absolute private persistent directory (outside web/public).
# ATTACHMENT_STORAGE_DIR=/var/lib/task-platform/attachments

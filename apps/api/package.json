{
  "name": "@task-platform/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/server serve",
    "build": "go build -trimpath ./...",
    "lint": "go vet ./...",
    "typecheck": "go test ./... -run ^$",
    "test": "go test ./...",
    "test:integration": "go test ./internal/platform -run TestCoreLifecycle -count=1",
    "test:e2e": "go test ./internal/platform -run TestCoreLifecycle -count=1",
    "db:migrate": "go run ./cmd/server migrate",
    "db:seed": "go run ./cmd/server seed-admin",
    "ai:configure": "go run ./cmd/server configure-ai"
  }
}

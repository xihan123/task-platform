# Local development only. These credentials are not production secrets.
POSTGRES_USER=task_platform
POSTGRES_PASSWORD=task_platform_dev
POSTGRES_DB=task_platform
POSTGRES_PORT=5432
REDIS_PORT=6379

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
# Set to 1 only when the API is reachable through one trusted reverse proxy.
# TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://task_platform:task_platform_dev@127.0.0.1:5432/task_platform
# For the optional API container, override its in-network URL if needed.
# API_DATABASE_URL=postgresql://task_platform:URL_ENCODED_PASSWORD@postgres:5432/task_platform
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=task-platform:
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_SECONDS=604800

# Enable only after configuring SMTP. No verification bypass when disabled.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
APP_URL=http://localhost:3000
# Independent base64-encoded 32 random bytes; keep stable across API instances.
# MAIL_ENCRYPTION_KEY=

MODERATION_ENABLED=true
AI_TIMEOUT_MS=120000
AI_COOLDOWN_SECONDS=60
# Configure these only when adding an AI resource with pnpm ai:configure.
# AI_KEY_ENCRYPTION_KEY=<base64-encoded 32 random bytes>
# AI_BASE_URL=https://api.example.com/v1/
# AI_MODEL=your-model-name
# AI_API_KEY=

# Required only for pnpm db:seed. No default ADMIN credentials.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
